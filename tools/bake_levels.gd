extends SceneTree
## Pre-computes every level and writes scripts/core/baked_levels.gd.
##   godot --headless --path . -s tools/bake_levels.gd
## Re-run whenever level generation changes (the tests fail if the baked data is out of date).

const OUT := "res://scripts/core/baked_levels.gd"


func _init() -> void:
	var lines := PackedStringArray()
	lines.append("class_name BakedLevels")
	lines.append("extends RefCounted")
	lines.append("## GENERATED by tools/bake_levels.gd - do not edit by hand.")
	lines.append("## Level -> tubes (each tube bottom -> top). Avoids running the solver while playing.")
	lines.append("")
	lines.append("const LEVELS := {")
	for level in range(1, LevelGenerator.LEVEL_COUNT + 1):
		lines.append("	%d: %s," % [level, str(LevelGenerator.generate_uncached(level))])
	lines.append("}")
	lines.append("")
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	if f == null:
		printerr("cannot write ", OUT)
		quit(1)
		return
	f.store_string("
".join(lines))
	f.close()
	print("baked %d levels to %s" % [LevelGenerator.LEVEL_COUNT, OUT])
	quit()
